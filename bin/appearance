#!/bin/bash
#
# Print or change the macOS appearance, which every Bereghici theme follows (Ghostty, nvim,
# tmux, herdr, VS Code...). AeroSpace runs `appearance toggle` on alt-cmd-shift-d.
#
# - Print the current appearance (`dark` or `light`), e.g. for `delta --features`:
#
# `appearance`
#
# - Switch between dark and light, or set one:
#
# `appearance toggle`
# `appearance dark`
# `appearance light`
#
# - Point the tools that can't follow it by themselves at the current appearance (setup runs it;
#   the launchd agent runs it with --if-changed whenever macOS changes appearance by itself):
#
# `appearance sync`
#
# ---

set -euo pipefail

# AeroSpace and launchd run it with the bare system PATH: herdr and friends live in Homebrew
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin}"

current() {
  # The key only exists in dark mode
  if [ "$(defaults read -g AppleInterfaceStyle 2> /dev/null)" = "Dark" ]; then
    echo dark
  else
    echo light
  fi
}

# Repoints the tools with one theme setting rather than one per appearance at the appearance's:
# delta (git and lazygit) through a git include, Claude Code and Codex through abereghici/themes'
# install.sh, and herdr-reviewr. The include doubles as the record of the last sync: with
# --if-changed (the launchd agent, on every global preferences write) nothing else runs when it
# already matches.
sync() {
  local install="$HOME/.local/share/bereghici/install.sh"
  local delta="$HOME/.local/state/dotfiles/delta.gitconfig"
  local feature="[delta]
  features = bereghici-$1"

  if [ "${2:-}" = --if-changed ] && [ "$(cat "$delta" 2> /dev/null)" = "$feature" ]; then
    return
  fi

  if [ -x "$install" ]; then
    "$install" sync "$1" > /dev/null
  fi
  if command -v herdr > /dev/null; then
    "$(dirname "$0")/herdr-reviewr-config" "$1" > /dev/null
  fi

  # Written last, so a failed step above is retried by the next --if-changed; whole, so git
  # never reads it half-written
  mkdir -p "$(dirname "$delta")"
  echo "$feature" > "$delta.tmp"
  mv "$delta.tmp" "$delta"
}

set_appearance() {
  local dark_mode=false
  [ "$1" = dark ] && dark_mode=true

  osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $dark_mode"
  sync "$1"
}

case "${1:-}" in
  "") current ;;
  toggle)
    if [ "$(current)" = dark ]; then
      set_appearance light
    else
      set_appearance dark
    fi
    ;;
  dark | light) set_appearance "$1" ;;
  sync) sync "$(current)" "${2:-}" ;;
  *)
    echo "Usage: $(basename "$0") [toggle | dark | light | sync [--if-changed]]"
    exit 1
    ;;
esac
