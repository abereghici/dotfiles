#!/bin/bash
#
# Kill the processes listening on the provided TCP port.
#
# - Release the port:
#
# `clear-port {{port}}`
#
# ---

set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "Usage: $(basename "$0") <port_number>"
  exit 1
fi

pids="$(lsof -nti TCP:"$1" -sTCP:LISTEN)" || {
  echo "Nothing listening on port $1" >&2
  exit 1
}
# word-split on purpose: one PID per line
kill $pids
