#!/bin/bash
#
# Run delta in the Bereghici Dark or Light feature for the current macOS appearance. delta has one
# syntax theme setting, not one per appearance, so git's pager and lazygit go through this.
#
# - Page a diff (git's core.pager):
#
# `git diff | delta-themed`
#
# ---

set -euo pipefail

# The same check as `appearance`, inline: lazygit runs this on every diff it renders, and calling
# the script would start another bash each time. AppleInterfaceStyle only exists in dark mode.
if [ "$(defaults read -g AppleInterfaceStyle 2> /dev/null)" = "Dark" ]; then
  appearance=dark
else
  appearance=light
fi

exec delta --features="bereghici-$appearance" "$@"
