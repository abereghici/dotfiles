#!/bin/bash
#
# Write herdr-reviewr's config.toml from ~/.config/herdr/reviewr.toml (tracked) and
# ~/.config/herdr/reviewr.local.toml (untracked, optional), plus the theme for the current macOS
# appearance (or the one given: dark|light). Run it after editing either (`appearance sync` runs
# it when the appearance changes); reviewr picks up the new file at once.
#
# ---

set -euo pipefail

dir="$HOME/.config/herdr"
config="$(herdr plugin config-dir persiyanov.reviewr)/config.toml"
tmp=$(mktemp "$config.XXXXXX") # written whole, then swapped in: reviewr reloads on change
trap 'command rm -f "$tmp"' EXIT

# reviewr's closest built-ins to Bereghici Dark and Light, unless a theme is set in either file
# (TOML rejects a key set twice)
if cat "$dir/reviewr.toml" "$dir/reviewr.local.toml" 2> /dev/null | grep -q '^theme *='; then
  theme=
elif [ "${1:-$("$(dirname "$0")/appearance")}" = dark ]; then
  theme='theme = "everforest"'
else
  theme='theme = "github-light"'
fi

{
  echo "# Generated by herdr-reviewr-config from $dir/reviewr.toml and reviewr.local.toml:"
  echo "# edit those and run it again."
  echo
  [ -n "$theme" ] && echo "$theme"
  cat "$dir/reviewr.toml"
  if [ -f "$dir/reviewr.local.toml" ]; then
    echo
    cat "$dir/reviewr.local.toml"
  fi
} > "$tmp"
cmp -s "$tmp" "$config" && exit
mv "$tmp" "$config"

echo "Wrote $config"
