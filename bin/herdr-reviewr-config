#!/bin/bash
#
# Write herdr-reviewr's config.toml from ~/.config/herdr/reviewr.toml (tracked) and
# ~/.config/herdr/reviewr.local.toml (untracked, optional). Run it after editing either;
# reviewr picks up the new file at once.
#
# ---

set -euo pipefail

dir="$HOME/.config/herdr"
config="$dir/plugins/config/persiyanov.reviewr/config.toml"

mkdir -p "$(dirname "$config")"
{
  echo "# Generated by herdr-reviewr-config from $dir/reviewr.toml and reviewr.local.toml:"
  echo "# edit those and run it again."
  echo
  cat "$dir/reviewr.toml"
  if [ -f "$dir/reviewr.local.toml" ]; then
    echo
    cat "$dir/reviewr.local.toml"
  fi
} > "$config"

echo "Wrote $config"
