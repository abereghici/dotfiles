# Ignore case, unless the pattern includes capital letters
--smart-case

# Include hidden files (good for .eslintrc kind of files)
--hidden

# Truncate lines longer than 150 columns, printing a preview instead
--max-columns=150
--max-columns-preview

# Ignore npm/pnpm/Yarn lock files and the .git directory
--glob=!package-lock.json
--glob=!pnpm-lock.yaml
--glob=!yarn.lock
--glob=!.git

# From abereghici/themes ports/ripgrep/themes/bereghici-terminal.ripgreprc (tests/setup.bats notices
# when it changes)
# Bereghici Terminal for ripgrep. Generated from abereghici/themes; do not edit.
# In the terminal's ANSI colors: with a Bereghici terminal theme it switches with it between
# Dark and Light.
# Add these lines to the file RIPGREP_CONFIG_PATH names.
--colors=path:fg:5
--colors=line:fg:2
--colors=column:fg:2
--colors=match:fg:1
--colors=match:style:bold
