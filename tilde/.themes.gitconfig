[delta "rosepine"]
  commit-decoration-style = "#c4a7e7" box
  dark = true
  file-decoration-style = "#26233a" overline
  file-added-label = [●]
  file-copied-label = [C]
  file-modified-label = [+]
  file-removed-label = [⛌]
  file-renamed-label = [→]
  file-style = "#f6c177" bold
  line-numbers = true
  line-numbers-left-format = "{nm:>1}┊"
  line-numbers-left-style = "#eb6f92"
  line-numbers-minus-style = "#eb6f92" bold
  line-numbers-plus-style = "#9ccfd8" bold
  line-numbers-right-format = " {np:>1}┊"
  line-numbers-right-style = "#9ccfd8"
  line-numbers-zero-style = "#6e6a86" italic
  minus-emph-style = "#eb6f92" bold
  minus-style = "#eb6f92"
  plus-emph-style = syntax bold
  plus-style = syntax
  syntax-theme = rose-pine # bat theme from ~/.config/bat/themes
  whitespace-error-style = "#8c3353" reverse
  zero-style = syntax
  blame-format = "{author:<18} ({commit:>7}) ┊{timestamp:^16}┊ "
