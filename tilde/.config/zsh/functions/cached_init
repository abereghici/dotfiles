# cached_init NAME COMMAND [ARGS...]
#
# Source the shell setup COMMAND ARGS prints (`starship init zsh`, `brew shellenv`...) from
# a compiled cache in ~/.cache/zsh, instead of running COMMAND on every shell start. The
# cache is rebuilt when COMMAND is upgraded (Homebrew relinks it, so the link's mtime is
# checked: the binary keeps its build date) or when the file calling cached_init changes.
# `rm -rf ~/.cache/zsh` forces a rebuild. Returns 1 if COMMAND is missing.

emulate -L zsh
zmodload -F zsh/stat b:zstat

local name=$1 cmd=$2
shift 2
local bin=${commands[$cmd]:-$cmd}
[[ -x $bin ]] || return 1

local cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/$name.zsh
local -a built linked caller
if [[ -s $cache ]]; then
  zstat -A built +mtime -- $cache
  zstat -L -A linked +mtime -- $bin
  zstat -A caller +mtime -- ${funcfiletrace[1]%:*} 2> /dev/null
fi

if (( ! $#built || linked[1] > built[1] || ${caller[1]:-0} > built[1] )); then
  mkdir -p ${cache:h}
  if ! { $bin "$@" >| $cache.$$ && mv -f $cache.$$ $cache && zcompile -R $cache }; then
    rm -f $cache.$$
    return 1
  fi
fi

# source picks up the compiled $cache.zwc
source $cache
