# Bereghici Dark/Light from ~/.config/ghostty/themes (abereghici/themes, installed by setup/misc.sh),
# switched live with the macOS appearance
theme = light:bereghici-light,dark:bereghici-dark
background-opacity = .85
background-opacity-cells = true

font-family = MesloLGS Nerd Font
# The Bereghici logo at U+100000, for the prompt (abereghici/themes ports/font, installed by setup)
font-codepoint-map = U+100000=Bereghici Symbols
font-size = 16.0

macos-titlebar-style = hidden
macos-option-as-alt = left

cursor-style-blink = false
mouse-hide-while-typing = true
window-padding-balance = true

window-inherit-font-size = true
window-inherit-working-directory = true
keybind = shift+enter=text:\x1b\r

# Left Option is Alt here, so type the ABC – Romanian layout's letters directly
keybind = alt+a=text:ă
keybind = alt+q=text:â
keybind = alt+i=text:î
keybind = alt+s=text:ș
keybind = alt+t=text:ț
keybind = alt+shift+a=text:Ă
keybind = alt+shift+q=text:Â
keybind = alt+shift+i=text:Î
keybind = alt+shift+s=text:Ș
keybind = alt+shift+t=text:Ț

# herdr is the multiplexer: let it have ctrl+tab for its tabs (cmd+shift+[ ] still switch
# Ghostty tabs)
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
